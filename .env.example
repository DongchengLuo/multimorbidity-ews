# ============================================================================
# Environment configuration template - copy to .env and edit as needed
#   cp .env.example .env
# The default (SNAPSHOT_MODE=1) runs the demo UI offline: no database, no LLM.
# Only features that call a large model (report generation / edge scoring)
# require the LLM settings below.
# ============================================================================

# ---------- Run mode ----------
# 1 = use the local de-identified snapshot in data/snapshot/ (default, recommended)
# 0 = connect directly to SQL Server (fill in MEDICAL_DB_* below)
SNAPSHOT_MODE=1

# ---------- Health-examination database (only needed when SNAPSHOT_MODE=0) ----------
MEDICAL_DB_SERVER=
MEDICAL_DB_NAME=
MEDICAL_DB_USER=
MEDICAL_DB_PASSWORD=

# ---------- LLM endpoint (OpenAI-compatible /v1/chat/completions) ----------
# Required: full URL, e.g.
#   http://10.0.0.5:8000/v1/chat/completions
#   https://api.openai.com/v1/chat/completions
LOCAL_LLM_API_URL=
# Required: model name, e.g. qwen2.5-72b-instruct / gpt-4o-mini
LOCAL_LLM_MODEL_NAME=
# Optional: API key; local vLLM usually uses EMPTY
LOCAL_LLM_API_KEY=EMPTY
# Whether to send chat_template_kwargs to the server (usually true for vLLM models)
LOCAL_LLM_SEND_CHAT_TEMPLATE_KWARGS=true

# ---------- Descriptive report extraction (llm_*.py) ----------
MEDICAL_LLM_TIMEOUT_SECONDS=1800
MEDICAL_LLM_MAX_WORKERS=256

# ---------- Downstream report generation (report_generator.py) ----------
# Tune timeouts and concurrency to your model throughput; these are conservative defaults.
REPORT_LLM_TIMEOUT=21600
REPORT_LLM_CONNECT_TIMEOUT=10
REPORT_LLM_RETRIES=1
REPORT_LLM_STREAM=1
REPORT_LLM_QUEUE_TIMEOUT=21600
REPORT_LLM_STALL_TIMEOUT=600
REPORT_LLM_MAX_INFLIGHT=128
REPORT_LLM_MAX_CONCURRENCY=128
REPORT_LLM_ACQUIRE_TIMEOUT=28800
REPORT_LLM_WAIT_TIMEOUT=86400
REPORT_TASK_RETRIES=1
REPORT_KNOWLEDGE_FALLBACK_CHARS=480000

REPORT_MAX_TOKENS=81920
JSONRENDER_MAX_TOKENS=81920
REPORT_KNOWLEDGE_MAX_TOKENS=81920
REPORT_KNOWLEDGE_CHUNK_CHARS=120000
REPORT_KNOWLEDGE_CHUNK_WORKERS=1

# ---------- Report language ----------
# en = English report (default, matches the English UI); zh = Chinese report
REPORT_LANGUAGE=en

# ---------- Report rendering ----------
# Single-file HTML; PDF requires the system weasyprint dependencies (see README)
REPORT_RENDER_HTML=1
REPORT_RENDER_PDF=1

# ---------- Optional: knowledge-graph location overrides ----------
# Defaults to data/kg/ inside the project; uncomment to reuse external large files:
# KG_DIR=/data/kg
# KG_PATH=/data/kg/knowledge_graph_normalized_with_weights.json
# KG_S2_PATH=/data/kg/comorbidity_combinations_S2.csv
# ICON_ROOT=/path/to/ui_icons
